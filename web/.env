# Default build (npm run dev / npm run build / Vercel): fake backend, demo accounts visible.
VITE_USE_MOCK=true
VITE_API_BASE=/api
# LINE Official Account add-friend link (e.g. https://lin.ee/AbCdEf). Leave empty to hide the LINE card.
VITE_LINE_OA_URL=
# Google sign-in OAuth client ID (public, not a secret). Its Authorized JavaScript origins must list this site.
# Never put the client secret here — the ID-token flow does not use it. Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=1045138621563-e17vo7qelp6g6v4c0i0f48vraras75j7.apps.googleusercontent.com
