# npm run build:aws → real backend, demo accounts and mock data are left out of the bundle.
# If CloudFront does NOT route /api/* to API Gateway, put the full invoke URL here instead, e.g.
# VITE_API_BASE=https://abc123.execute-api.ap-southeast-1.amazonaws.com/prod/api
VITE_USE_MOCK=false
VITE_API_BASE=/api
