# npm run build:aws → real backend, demo accounts and mock data are left out of the bundle.
# If CloudFront does NOT route /api/* to the backend, put the full backend URL here instead, e.g.
#   API Gateway: VITE_API_BASE=https://abc123.execute-api.us-east-1.amazonaws.com/prod/api
#   ALB:         VITE_API_BASE=https://lostfound-alb-123456.us-east-1.elb.amazonaws.com/api
VITE_USE_MOCK=false
VITE_API_BASE=/api
# LINE Official Account add-friend link (e.g. https://lin.ee/AbCdEf). Leave empty to hide the LINE card.
VITE_LINE_OA_URL=
