# npm run build:aws → real backend, demo accounts and mock data are left out of the bundle.
# Learner Lab does not allow CloudFront, so the site is served from the S3 static-website endpoint (HTTP)
# and calls the ALB directly. Both are plain HTTP, so the browser does not block the call as mixed content.
# The API must answer CORS for the S3 website origin — see docs/API_CONTRACT.md §0 and §4.
VITE_USE_MOCK=false
# Replace with the ALB DNS name, e.g. http://bu-lostfound-alb-123456.us-east-1.elb.amazonaws.com/api
# If EC2 also serves dist/ behind the same ALB, use /api instead.
VITE_API_BASE=http://REPLACE-WITH-ALB-DNS/api
# LINE Official Account add-friend link (e.g. https://lin.ee/AbCdEf). Leave empty to hide the LINE card.
VITE_LINE_OA_URL=
# Google only accepts HTTPS origins (except localhost), so Google sign-in cannot run on the HTTP S3 website.
# Leave empty to hide the button there; students use email + password instead.
VITE_GOOGLE_CLIENT_ID=
