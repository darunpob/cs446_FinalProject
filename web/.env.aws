# npm run build:aws → real backend, demo accounts and mock data are left out of the bundle.
# Backend = ALB + EC2 Auto Scaling + RDS behind CloudFront. CloudFront routes /api/* to the ALB,
# so the site and the API share one HTTPS origin and /api works as-is.
# Do not point this at the ALB DNS name directly: it is HTTP-only, and an HTTPS page cannot call it.
VITE_USE_MOCK=false
VITE_API_BASE=/api
# LINE Official Account add-friend link (e.g. https://lin.ee/AbCdEf). Leave empty to hide the LINE card.
VITE_LINE_OA_URL=
